<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactoryCutPlanner.ViewModels"
             x:Class="FactoryCutPlanner.Views.ProductsPageView"
             x:DataType="vm:ProductsPageViewModel">

  <!-- Two-column layout: Form (left, 2*) | Product List (right, 3*) -->
  <Grid ColumnDefinitions="2*,3*" RowDefinitions="Auto,*" Margin="16">

    <!-- ═══════════════════════════════════════════════ -->
    <!-- HEADER                                          -->
    <!-- ═══════════════════════════════════════════════ -->
    <Border Grid.Row="0" Grid.ColumnSpan="2"
            Background="#1E1E2E" CornerRadius="12"
            Padding="20,14" Margin="0,0,0,12">
      <TextBlock Text="📦  Ürün Tanımları"
                 FontSize="20" FontWeight="Bold" Foreground="#CDD6F4"/>
    </Border>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- LEFT PANEL — ADD PRODUCT FORM                   -->
    <!-- ═══════════════════════════════════════════════ -->
    <Border Grid.Row="1" Grid.Column="0"
            Background="#1E1E2E" CornerRadius="12"
            Margin="0,0,6,0" Padding="16">
      <DockPanel>
        <!-- Title -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Yeni Ürün Ekle"
                   FontSize="16" FontWeight="Bold" Foreground="#CDD6F4"
                   Margin="0,0,0,12"/>

        <!-- Save button at bottom -->
        <Button DockPanel.Dock="Bottom"
                Content="💾  Ürünü Kaydet"
                Command="{Binding SaveProductCommand}"
                HorizontalAlignment="Stretch" Height="42"
                FontSize="14" FontWeight="Bold"
                Background="#A6E3A1" Foreground="#1E1E2E"
                CornerRadius="10"
                Margin="0,8,0,0"/>

        <!-- Status message -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusMessage}"
                   Foreground="{Binding StatusColor}"
                   FontSize="12" Margin="0,4,0,0"
                   IsVisible="{Binding HasStatus}"/>

        <!-- Scrollable form content -->
        <ScrollViewer>
          <StackPanel Spacing="4">

            <!-- ── Ürün Adı ── -->
            <TextBlock Text="Ürün Adı *" FontSize="12" Foreground="#6C7086" Margin="0,4,0,2"/>
            <TextBox Text="{Binding ProductName}"
                     PlaceholderText="Örn: Dikdörtgen Kanal 300x200"
                     Margin="0,0,0,8"/>

            <!-- ── Açıklama ── -->
            <TextBlock Text="Açıklama" FontSize="12" Foreground="#6C7086" Margin="0,4,0,2"/>
            <TextBox Text="{Binding Description}"
                     PlaceholderText="Opsiyonel açıklama"
                     Margin="0,0,0,12"/>

            <!-- ── Ürün Tipi ── -->
            <TextBlock Text="Ürün Tipi *" FontSize="12" Foreground="#6C7086" Margin="0,4,0,2"/>
            <ComboBox ItemsSource="{Binding ProductTypeOptions}"
                      SelectedItem="{Binding SelectedProductType}"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,12"/>

            <!-- ════════════════════════════════════════ -->
            <!-- SPEC PANELS (only one visible at a time) -->
            <!-- ════════════════════════════════════════ -->

            <!-- Rectangular Duct Specs -->
            <StackPanel IsVisible="{Binding IsRectangularDuct}" Spacing="4">
              <TextBlock Text="EBATLAR (mm)" FontSize="10" FontWeight="Bold"
                         Foreground="#6C7086" Margin="0,4,0,4"/>
              <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,8,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Genişlik" FontSize="11" Foreground="#6C7086"/>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SpecWidth}" PlaceholderText="mm"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Yükseklik" FontSize="11" Foreground="#6C7086"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SpecHeight}" PlaceholderText="mm"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Uzunluk" FontSize="11" Foreground="#6C7086"/>
                <TextBox Grid.Row="4" Grid.Column="0" Text="{Binding SpecLength}" PlaceholderText="mm"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Sac Kalınlığı" FontSize="11" Foreground="#6C7086"/>
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding SpecThickness}" PlaceholderText="mm"/>
              </Grid>
              <CheckBox Content="Yalıtım Var"
                        IsChecked="{Binding SpecInsulationEnabled}"
                        Margin="0,4,0,0"/>
            </StackPanel>

            <!-- AHU Cabinet Specs -->
            <StackPanel IsVisible="{Binding IsAhuCabinet}" Spacing="4">
              <TextBlock Text="KABİN EBATLARI (mm)" FontSize="10" FontWeight="Bold"
                         Foreground="#6C7086" Margin="0,4,0,4"/>
              <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,8,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Genişlik" FontSize="11" Foreground="#6C7086"/>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SpecWidth}" PlaceholderText="mm"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Yükseklik" FontSize="11" Foreground="#6C7086"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SpecHeight}" PlaceholderText="mm"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Uzunluk" FontSize="11" Foreground="#6C7086"/>
                <TextBox Grid.Row="4" Grid.Column="0" Text="{Binding SpecLength}" PlaceholderText="mm"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Panel Kalınlığı" FontSize="11" Foreground="#6C7086"/>
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding SpecPanelThickness}" PlaceholderText="mm"/>
              </Grid>
              <CheckBox Content="Profil Çerçeve Mevcut"
                        IsChecked="{Binding SpecHasProfileFramework}"
                        Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Fitting Specs -->
            <StackPanel IsVisible="{Binding IsFittingDuct}" Spacing="4">
              <TextBlock Text="BAĞLANTI PARÇASI ÖZELLİKLERİ" FontSize="10" FontWeight="Bold"
                         Foreground="#6C7086" Margin="0,4,0,4"/>
              <TextBlock Text="Parça Şekli" FontSize="11" Foreground="#6C7086"/>
              <ComboBox ItemsSource="{Binding FittingShapeOptions}"
                        SelectedItem="{Binding SelectedFittingShape}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,4"/>
              <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ana Ölçü" FontSize="11" Foreground="#6C7086"/>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SpecMainDimension}" PlaceholderText="mm"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Sac Kalınlığı" FontSize="11" Foreground="#6C7086"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SpecFittingThickness}" PlaceholderText="mm"/>
              </Grid>
              <TextBlock Text="Açı (opsiyonel)" FontSize="11" Foreground="#6C7086" Margin="0,4,0,0"/>
              <TextBox Text="{Binding SpecAngle}" PlaceholderText="derece" Width="120" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- ═══════════════════════════════════ -->
            <!-- BOM — MALZEME LİSTESİ              -->
            <!-- ═══════════════════════════════════ -->
            <Separator Margin="0,12,0,8"/>

            <DockPanel Margin="0,0,0,4">
              <TextBlock Text="BOM — Malzeme Listesi"
                         FontSize="12" FontWeight="Bold" Foreground="#CDD6F4"
                         VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right"
                      Content="＋ Satır Ekle"
                      Command="{Binding AddBomRowCommand}"
                      FontSize="11" Height="28" Padding="12,0"
                      Background="#313244" Foreground="#CDD6F4"
                      CornerRadius="6"
                      HorizontalAlignment="Right"/>
            </DockPanel>

            <!-- BOM rows — ItemsControl bound to ObservableCollection -->
            <ItemsControl ItemsSource="{Binding BomItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BomItemViewModel">
                  <Border Background="#252536" CornerRadius="8" Padding="6" Margin="0,2">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                      <TextBox Grid.Column="0" Text="{Binding MaterialName}"
                               PlaceholderText="Malzeme adı" Margin="0,0,4,0"/>
                      <TextBox Grid.Column="1" Text="{Binding Unit}"
                               PlaceholderText="Birim" Width="70" Margin="0,0,4,0"/>
                      <TextBox Grid.Column="2" Text="{Binding QuantityPerUnit}"
                               PlaceholderText="Miktar" Width="70" Margin="0,0,4,0"/>
                      <TextBox Grid.Column="3" Text="{Binding CostPerUnit}"
                               PlaceholderText="Maliyet" Width="70" Margin="0,0,4,0"/>
                      <Button Grid.Column="4" Content="✕"
                              Width="28" Height="28"
                              Background="#F38BA8" Foreground="#1E1E2E"
                              CornerRadius="6" FontWeight="Bold"
                              Command="{Binding $parent[ItemsControl].((vm:ProductsPageViewModel)DataContext).RemoveBomRowCommand}"
                              CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- RIGHT PANEL — PRODUCT LIST                      -->
    <!-- ═══════════════════════════════════════════════ -->
    <Border Grid.Row="1" Grid.Column="1"
            Background="#1E1E2E" CornerRadius="12"
            Margin="6,0,0,0" Padding="16">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Kayıtlı Ürünler"
                   FontSize="16" FontWeight="Bold" Foreground="#CDD6F4"
                   Margin="0,0,0,8"/>

        <!-- DataGrid showing all products -->
        <DataGrid ItemsSource="{Binding Products}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
            <DataGridTextColumn Header="Ürün Adı" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="Tip" Binding="{Binding ProductTypeLabel}" Width="150"/>
            <DataGridTextColumn Header="Özellikler" Binding="{Binding SpecSummary}" Width="*"/>
            <DataGridTextColumn Header="BOM" Binding="{Binding BomSummary}" Width="150"/>
            <DataGridTemplateColumn Header="" Width="60">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ProductListItem">
                  <Button Content="Sil"
                          FontSize="11" Height="26" Padding="8,0"
                          Background="#F38BA8" Foreground="#1E1E2E"
                          CornerRadius="6"
                          Command="{Binding $parent[DataGrid].((vm:ProductsPageViewModel)DataContext).DeleteProductCommand}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
